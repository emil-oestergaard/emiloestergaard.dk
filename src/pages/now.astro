---
import ProseLayout from '../layouts/ProseLayout.astro';

const lastUpdated = new Date('2026-04-22');
const formattedUpdated = lastUpdated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<ProseLayout
  title="Now"
  description="What Emil Østergaard is focused on right now. Updated when things change, not on a schedule."
>
  <p class="now-meta">
    Last updated <time datetime={lastUpdated.toISOString()}>{formattedUpdated}</time>. This page
    follows the <a href="https://nownownow.com/about" rel="noopener noreferrer" target="_blank"
      >/now page convention</a
    > — a snapshot of what I'm actually spending my time on, updated when it changes.
  </p>

  <h2>Work</h2>
  <p>
    AI Engineer at <a href="https://umage.ai" rel="noopener noreferrer" target="_blank">umage.ai</a>,
    an AI consultancy for Nordic enterprises — agentic systems, AI adoption, and running
    open-weight models on customer infrastructure. Most of my time goes to the engineering side:
    building production-grade agentic code and helping teams put it into real products.
  </p>

  <h2>School</h2>
  <p>
    Fourth semester of a BSc in Computer Science at the University of Copenhagen. Currently working
    through algorithms and systems coursework.
  </p>

  <h2>Not right now</h2>
  <ul>
    <li>Taking on freelance work</li>
    <li>New long-term commitments outside work and school</li>
  </ul>

  <p class="now-footer">
    If you'd like to get in touch, <a href="mailto:emiloestergaard03@proton.me">send me an email</a>.
  </p>
</ProseLayout>

<style>
  .now-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-12);
  }

  .now-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
