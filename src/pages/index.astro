---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const homeDescription =
  'Emil Østergaard — Computer Science student at the University of Copenhagen and AI Engineer at umage.ai. Personal site with projects and notes from Copenhagen, Denmark.';

const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author.name,
      alternateName: SITE.author.alternateName,
      url: SITE.url,
      email: `mailto:${SITE.author.email}`,
      sameAs: [SITE.author.github, SITE.author.linkedin],
      jobTitle: 'AI Engineer',
      worksFor: {
        '@type': 'Organization',
        name: 'umage.ai',
        url: 'https://umage.ai',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Copenhagen',
        url: 'https://www.ku.dk',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Copenhagen',
        addressCountry: 'DK',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE.url,
      name: SITE.title,
      alternateName: SITE.author.alternateName,
      description: homeDescription,
      inLanguage: SITE.locale,
      publisher: { '@id': personId },
      author: { '@id': personId },
    },
  ],
};
---

<BaseLayout title="Emil Østergaard" description={homeDescription} jsonLd={jsonLd}>
  <section class="intro">
    <p class="intro__lede">
      I'm Emil Østergaard — a Computer Science student at the University of Copenhagen and an AI
      Engineer at <a href="https://umage.ai" rel="noopener noreferrer" target="_blank">umage.ai</a>.
    </p>
    <p class="intro__meta">
      More on the <a href="/about/">about</a> page. You can reach me by <a
        href="mailto:emiloestergaard03@proton.me">email</a
      >.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    margin: var(--space-8) 0 var(--space-16);
  }

  .intro__lede {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .intro__meta {
    color: var(--color-text-muted);
  }
</style>
