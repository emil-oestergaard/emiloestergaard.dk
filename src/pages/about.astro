---
import ProseLayout from '../layouts/ProseLayout.astro';
import { SITE } from '../consts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.author.name,
  alternateName: SITE.author.alternateName,
  url: SITE.url,
  mainEntityOfPage: `${SITE.url}/about/`,
  email: `mailto:${SITE.author.email}`,
  sameAs: [SITE.author.github, SITE.author.linkedin],
  jobTitle: 'AI Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'umage.ai',
    url: 'https://umage.ai',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Copenhagen',
    url: 'https://www.ku.dk',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Copenhagen',
    addressCountry: 'DK',
  },
};
---

<ProseLayout
  title="About"
  description="About Emil Østergaard — Computer Science student at the University of Copenhagen and AI Engineer at umage.ai."
  jsonLd={jsonLd}
>
  <p>
    I study Computer Science at the University of Copenhagen and work as an AI Engineer at
    <a href="https://umage.ai" rel="noopener noreferrer" target="_blank">umage.ai</a>. Before umage,
    I spent two and a half years at IT Instituttet.
  </p>

  <p>
    I joined IT Instituttet as a freelancer in my first semester of university and grew into a
    full-time lead role over the next two and a half years.
  </p>

  <p>
    umage is an AI consultancy for Nordic enterprises — the engineering and advisory work of helping
    teams put AI into production, with a focus on agentic systems and on running open-weight models
    on customer infrastructure rather than in the cloud. I work on the engineering side of that.
  </p>

  <p>
    Alongside work and school, I tend to build small things from scratch — an HTTP server in C, a
    distributed key-value store in Go, a short search engine in Python. Building them end-to-end is
    how I make sure I actually understand the layers I rely on the rest of the time.
  </p>

  <p>
    I care about software that is legible, durable, and pleasant to use — the kind where complexity
    lives in the right place, and a careful reader can follow how the pieces fit together.
  </p>

  <p>
    What I'm actively working on lives on the <a href="/now/">/now</a> page. A selection of things I'm
    proud of lives on <a href="/projects/">/projects</a>.
  </p>

  <hr />

  <h2>Background</h2>

  <p>
    <strong>Now.</strong> AI Engineer at umage.ai (Apr 2026 - present).
  </p>

  <p>
    <strong>Previously.</strong> Junior Software & Full-Stack Developer at IT Instituttet (Oct 2023 -
    Apr 2026).
  </p>

  <p>
    <strong>Education.</strong> BSc in Computer Science, University of Copenhagen (2023 - present).
  </p>

  <h2>Elsewhere</h2>
  <ul>
    <li><a href="mailto:emiloestergaard03@proton.me">Email</a></li>
    <li>
      <a href="https://github.com/emil-oestergaard/" rel="me noopener noreferrer" target="_blank"
        >GitHub</a
      >
    </li>
    <li>
      <a
        href="https://www.linkedin.com/in/emil-%C3%B8stergaard-0671472a5/"
        rel="me noopener noreferrer"
        target="_blank">LinkedIn</a
      >
    </li>
  </ul>
</ProseLayout>
